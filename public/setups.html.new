<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Setup Scanner</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#080b11;--bg-card:#0d1117;--bg-raised:#121820;--bg-input:#0a0f16;
  --border:#1c2435;--border-mid:#243044;
  --text-primary:#dde4f0;--text-secondary:#9aa3b5;--text-muted:#5a6478;
  --green:#00e5a0;--red:#ff4d6a;--amber:#f5a623;--blue:#4da8ff;--purple:#a78bfa;
  --green-dim:#051a10;--red-dim:#1a0509;--amber-dim:#1a1100;
  --font-ui:'Space Grotesk',system-ui,sans-serif;--font-mono:'JetBrains Mono',monospace;
  --radius:10px;--radius-sm:6px;--radius-lg:14px;
}
html,body{min-height:100%;background:var(--bg);color:var(--text-primary);font-family:var(--font-ui);font-size:clamp(14px,1vw,20px);line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1200px;margin:0 auto;padding:1rem 1rem 3rem}
html.light-mode{--bg:#f2f5fb;--bg-card:#fff;--bg-raised:#e8edf6;--bg-input:#edf1f8;--border:#cdd5e3;--border-mid:#b4bfcf;--text-primary:#1a2335;--text-secondary:#445068;--text-muted:#7080a0;}

/* Header */
.page-header{margin-bottom:2rem}
.page-title{font-size:1.8rem;font-weight:800;margin-bottom:0.5rem}
.page-sub{font-size:0.9rem;color:var(--text-muted)}

/* Controls bar */
.controls-bar{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;margin-bottom:1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;align-items:flex-end}
.control-group{display:flex;flex-direction:column}
.control-label{font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:0.4rem}
.control-input{background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.6rem 0.8rem;color:var(--text-primary);font-family:var(--font-ui);font-size:0.9rem;outline:none;transition:border-color 0.15s}
.control-input:focus{border-color:var(--green)}
.scan-btn{background:var(--green);color:#000;font-weight:800;padding:0.7rem 1.8rem;border:none;border-radius:var(--radius-sm);cursor:pointer;font-size:0.95rem;transition:opacity 0.15s;grid-column:span 2}
.scan-btn:hover{opacity:0.88}
.scan-btn:disabled{opacity:0.45;cursor:not-allowed}

/* Progress */
.progress-wrap{background:var(--bg-raised);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-bottom:1.5rem;display:none}
.progress-step{font-size:0.85rem;color:var(--text-secondary);margin-bottom:0.5rem}
.progress-bar{height:6px;background:var(--border);border-radius:3px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--blue));width:0%;transition:width 0.3s ease}

/* Filters row */
.filters-row{display:flex;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;align-items:center}
.filter-btn{background:transparent;border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.5rem 1rem;color:var(--text-secondary);font-size:0.85rem;font-weight:600;cursor:pointer;transition:all 0.15s;font-family:var(--font-ui)}
.filter-btn.active{background:var(--green);color:#000;border-color:var(--green)}
.filter-btn:hover:not(.active){border-color:var(--green)}
.results-count{margin-left:auto;font-size:0.85rem;color:var(--text-muted)}

/* Signal cards grid */
.signals-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:1rem;margin-bottom:2rem}
.signal-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;transition:all 0.15s;animation:cardFadeIn 0.4s ease}
@keyframes cardFadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.signal-card.long{border-left:4px solid var(--green)}
.signal-card.short{border-left:4px solid var(--red)}
.signal-card.a-plus{box-shadow:inset 0 0 0 1px var(--amber),0 0 16px rgba(245,166,35,0.2)}

/* Card header */
.card-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem}
.card-symbol{font-size:1.4rem;font-weight:800;color:var(--text-primary)}
.card-badges{display:flex;gap:0.4rem;flex-wrap:wrap}
.badge{display:inline-flex;align-items:center;padding:0.3rem 0.65rem;border-radius:4px;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px}
.badge.direction{background:var(--green-dim);color:var(--green);border:1px solid #0a3320}
.badge.direction.short{background:var(--red-dim);color:var(--red);border:1px solid #3a0510}
.badge.grade-aplus{background:var(--amber-dim);color:var(--amber);border:1px solid #3a2600}
.badge.grade-a{background:var(--green-dim);color:var(--green)}
.badge.grade-b{background:rgba(77,168,255,0.15);color:var(--blue)}
.badge.grade-c{background:var(--amber-dim);color:var(--amber)}
.badge.confidence-high{background:var(--green-dim);color:var(--green)}
.badge.confidence-medium{background:var(--amber-dim);color:var(--amber)}
.badge.confidence-low{background:var(--red-dim);color:var(--red)}

/* Score section */
.score-section{background:var(--bg-raised);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-bottom:1rem}
.score-display{display:flex;align-items:center;gap:1rem;margin-bottom:0.8rem}
.score-circle{width:60px;height:60px;border-radius:50%;background:var(--bg-card);border:3px solid var(--green);display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:800;color:var(--green)}
.score-breakdown{display:flex;flex-direction:column;gap:0.35rem;flex:1}
.score-item{display:flex;align-items:center;gap:0.4rem;font-size:0.75rem}
.score-bar{height:4px;background:var(--border);border-radius:2px;flex:1;overflow:hidden}
.score-fill{height:100%;background:var(--green);border-radius:2px;transition:width 0.3s}
.score-label{color:var(--text-muted);min-width:60px}
.score-value{color:var(--text-secondary);font-weight:700;min-width:35px;text-align:right}

/* Trade levels */
.levels-section{margin-bottom:1rem}
.level-row{display:flex;justify-content:space-between;align-items:center;padding:0.6rem;font-size:0.85rem;border-bottom:1px solid var(--border)}
.level-row:last-child{border-bottom:none}
.level-label{color:var(--text-muted)}
.level-value{font-family:var(--font-mono);font-weight:700;color:var(--text-primary)}
.level-value.sl{color:var(--red)}
.level-value.tp{color:var(--green)}
.level-distance{color:var(--text-secondary);font-size:0.75rem}

/* Position sizing */
.sizing-section{background:var(--bg-raised);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.8rem;margin-bottom:1rem;font-size:0.8rem}
.sizing-row{display:flex;justify-content:space-between;padding:0.4rem 0}
.sizing-label{color:var(--text-muted)}
.sizing-value{font-family:var(--font-mono);font-weight:700;color:var(--text-secondary)}

/* Reasons & warnings */
.reasons-section{margin-bottom:1rem}
.reason-list{display:flex;flex-direction:column;gap:0.3rem;font-size:0.8rem}
.reason{color:var(--text-secondary);padding:0.3rem 0}
.reason::before{content:'✓ ';color:var(--green);font-weight:700}
.warnings-section{margin-bottom:1rem}
.warning-chip{display:inline-flex;align-items:center;gap:0.3rem;background:rgba(245,166,35,0.15);color:var(--amber);border:1px solid var(--amber);border-radius:4px;padding:0.35rem 0.65rem;font-size:0.75rem;font-weight:600;margin-right:0.4rem;margin-bottom:0.4rem}

/* Indicators footer */
.indicators-footer{display:grid;grid-template-columns:repeat(2,1fr);gap:0.5rem;font-size:0.75rem;padding-top:1rem;border-top:1px solid var(--border)}
.indicator-item{display:flex;justify-content:space-between}
.indicator-label{color:var(--text-muted)}
.indicator-value{font-family:var(--font-mono);font-weight:700;color:var(--text-secondary)}

/* Card actions */
.card-actions{display:flex;gap:0.5rem;margin-top:1rem}
.action-btn{flex:1;padding:0.5rem 0.6rem;background:var(--bg-raised);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-secondary);font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.15s;font-family:var(--font-ui)}
.action-btn:hover{background:var(--border-mid);color:var(--green);border-color:var(--green)}
.action-btn.primary{background:var(--green);color:#000;border-color:var(--green)}
.action-btn.primary:hover{opacity:0.88}

/* Empty state */
.empty-state{text-align:center;padding:3rem 1rem;color:var(--text-muted)}
.empty-icon{font-size:2.5rem;margin-bottom:1rem}
.empty-text{font-size:1rem;margin-bottom:0.5rem}
.empty-sub{font-size:0.9rem;color:var(--text-muted)}

/* Spinner */
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid var(--border-mid);border-top-color:var(--green);border-radius:50%;animation:spin 0.7s linear infinite}
</style>
</head>
<body>
<script src="/js/nav.js"></script>
<div class="wrap">

  <!-- Page Header -->
  <div class="page-header">
    <div class="page-title">⚙️ Setup Scanner</div>
    <div class="page-sub">8-step apex scanner with technical analysis, AI scoring, and full position sizing</div>
  </div>

  <!-- Controls Bar -->
  <div class="controls-bar">
    <div class="control-group">
      <div class="control-label">Account Size ($)</div>
      <input type="number" class="control-input" id="accountSize" value="1000" min="100"/>
    </div>
    <div class="control-group">
      <div class="control-label">Risk %</div>
      <input type="number" class="control-input" id="riskPercent" value="1" min="0.1" max="5" step="0.1"/>
    </div>
    <div class="control-group">
      <div class="control-label">RR Ratio</div>
      <input type="number" class="control-input" id="rrRatio" value="1.5" min="1" step="0.1"/>
    </div>
    <div class="control-group">
      <div class="control-label">Min Score</div>
      <input type="number" class="control-input" id="minScore" value="35" min="10" max="90"/>
    </div>
    <div class="control-group">
      <div class="control-label">Coins to Scan</div>
      <input type="number" class="control-input" id="coinsToScan" value="50" min="10" max="250"/>
    </div>
    <button class="scan-btn" id="scanBtn" onclick="startScan()">
      <span id="scanBtnText">🚀 Run Scanner</span>
    </button>
  </div>

  <!-- Progress -->
  <div class="progress-wrap" id="progressWrap">
    <div class="progress-step" id="progressStep">Starting scan...</div>
    <div class="progress-bar">
      <div class="progress-fill" id="progressFill"></div>
    </div>
  </div>

  <!-- Filters Row -->
  <div class="filters-row" id="filtersRow" style="display:none">
    <div style="font-size:0.85rem;font-weight:600;color:var(--text-muted)">Direction:</div>
    <button class="filter-btn active" onclick="filterBy('direction','all')">All</button>
    <button class="filter-btn" onclick="filterBy('direction','LONG')">LONG</button>
    <button class="filter-btn" onclick="filterBy('direction','SHORT')">SHORT</button>
    
    <div style="font-size:0.85rem;font-weight:600;color:var(--text-muted);margin-left:1rem">Confidence:</div>
    <button class="filter-btn active" onclick="filterBy('confidence','all')">All</button>
    <button class="filter-btn" onclick="filterBy('confidence','HIGH')">HIGH</button>
    <button class="filter-btn" onclick="filterBy('confidence','MEDIUM')">MEDIUM</button>
    <button class="filter-btn" onclick="filterBy('confidence','LOW')">LOW</button>

    <div style="font-size:0.85rem;font-weight:600;color:var(--text-muted);margin-left:1rem">Grade:</div>
    <button class="filter-btn active" onclick="filterBy('grade','all')">All</button>
    <button class="filter-btn" onclick="filterBy('grade','A+')">A+</button>
    <button class="filter-btn" onclick="filterBy('grade','A')">A</button>
    <button class="filter-btn" onclick="filterBy('grade','B')">B</button>

    <div style="margin-left:auto;display:flex;align-items:center;gap:0.5rem">
      <div style="font-size:0.85rem;font-weight:600;color:var(--text-muted)">Sort:</div>
      <select onchange="sortBy(this.value)" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);padding:0.4rem 0.6rem;border-radius:var(--radius-sm);font-family:var(--font-ui);font-size:0.85rem">
        <option value="score">Score</option>
        <option value="confidence">Confidence</option>
        <option value="grade">Grade</option>
      </select>
    </div>
    <div class="results-count" id="resultsCount">Showing 0 signals</div>
  </div>

  <!-- Signals Grid -->
  <div class="signals-grid" id="signalsGrid"></div>

  <!-- Empty State -->
  <div class="empty-state" id="emptyState" style="display:none">
    <div class="empty-icon"><i class="fa-solid fa-magnifying-glass" ></i></div>
    <div class="empty-text">No signals found</div>
    <div class="empty-sub">Run a scan to find trading signals</div>
  </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const scanBtn = document.getElementById('scanBtn');
const progressWrap = document.getElementById('progressWrap');
const progressFill = document.getElementById('progressFill');
const progressStep = document.getElementById('progressStep');
const signalsGrid = document.getElementById('signalsGrid');
const emptyState = document.getElementById('emptyState');
const filtersRow = document.getElementById('filtersRow');
const resultsCount = document.getElementById('resultsCount');

let allSignals = [];
let currentFilters = { direction: 'all', confidence: 'all', grade: 'all', sort: 'score' };

async function startScan() {
  try {
    scanBtn.disabled = true;
    signalsGrid.innerHTML = '';
    emptyState.style.display = 'none';
    filtersRow.style.display = 'none';
    progressWrap.style.display = 'block';
    progressFill.style.width = '0%';
    
    const params = new URLSearchParams({
      coins: document.getElementById('coinsToScan').value,
      accountSize: document.getElementById('accountSize').value,
      riskPercent: document.getElementById('riskPercent').value,
      rrRatio: document.getElementById('rrRatio').value,
      minScore: document.getElementById('minScore').value,
    });
    
    const res = await fetch(`/api/setups/run?${params}`);
    if (!res.ok) {
      const err = await res.json();
      progressStep.textContent = `Error: ${err.error || 'Scan failed'}`;
      scanBtn.disabled = false;
      return;
    }
  } catch (err) {
    progressStep.textContent = `Error: ${err.message}`;
    scanBtn.disabled = false;
  }
}

// Socket.io
try {
  const sock = io();
  sock.on('apex:progress', (data) => {
    progressStep.textContent = data.step;
    progressFill.style.width = data.progress + '%';
  });
  
  sock.on('apex:done', (data) => {
    allSignals = data.signals || [];
    progressStep.textContent = `Scan complete! Found ${allSignals.length} signals`;
    progressFill.style.width = '100%';
    setTimeout(() => {
      progressWrap.style.display = 'none';
      renderSignals();
    }, 800);
    scanBtn.disabled = false;
  });
  
  sock.on('apex:error', (data) => {
    progressStep.textContent = `Error: ${data.error}`;
    scanBtn.disabled = false;
  });
} catch {}

function renderSignals() {
  let filtered = allSignals;
  
  // Apply filters
  if (currentFilters.direction !== 'all') {
    filtered = filtered.filter(s => s.direction === currentFilters.direction);
  }
  if (currentFilters.confidence !== 'all') {
    filtered = filtered.filter(s => s.confidence === currentFilters.confidence);
  }
  if (currentFilters.grade !== 'all') {
    filtered = filtered.filter(s => s.grade === currentFilters.grade);
  }
  
  // Sort
  if (currentFilters.sort === 'score') {
    filtered.sort((a, b) => b.score - a.score);
  } else if (currentFilters.sort === 'confidence') {
    const confOrder = { 'HIGH': 0, 'MEDIUM': 1, 'LOW': 2 };
    filtered.sort((a, b) => confOrder[a.confidence] - confOrder[b.confidence]);
  } else if (currentFilters.sort === 'grade') {
    const gradeOrder = { 'A+': 0, 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'F': 5 };
    filtered.sort((a, b) => gradeOrder[a.grade] - gradeOrder[b.grade]);
  }
  
  resultsCount.textContent = `Showing ${filtered.length} signals`;
  
  if (filtered.length === 0) {
    signalsGrid.innerHTML = '';
    emptyState.style.display = 'block';
    filtersRow.style.display = 'none';
    return;
  }
  
  filtersRow.style.display = 'flex';
  
  signalsGrid.innerHTML = filtered.map(s => `
    <div class="signal-card ${s.direction.toLowerCase()} grade-${s.grade.toLowerCase().replace('+','-plus')}">
      <div class="card-header">
        <div class="card-symbol">${s.symbol.replace('USDT','')}</div>
        <div class="card-badges">
          <span class="badge direction ${s.direction === 'SHORT' ? 'short' : ''}">${s.direction}</span>
          <span class="badge grade-${s.grade.toLowerCase().replace('+','-plus')}">${s.grade}</span>
          <span class="badge confidence-${s.confidence.toLowerCase()}">${s.confidence}</span>
        </div>
      </div>
      
      <div class="score-section">
        <div class="score-display">
          <div class="score-circle">${s.score}</div>
          <div class="score-breakdown">
            <div class="score-item">
              <div class="score-label">Trend</div>
              <div class="score-bar"><div class="score-fill" style="width:${(s.score / 100) * 100}%"></div></div>
              <div class="score-value">${Math.round((s.score / 100) * 30)}/30</div>
            </div>
            <div class="score-item">
              <div class="score-label">Momentum</div>
              <div class="score-bar"><div class="score-fill" style="width:${Math.min((s.score / 100) * 100, 100)}%"></div></div>
              <div class="score-value">${Math.round((s.score / 100) * 25)}/25</div>
            </div>
            <div class="score-item">
              <div class="score-label">Volume</div>
              <div class="score-bar"><div class="score-fill" style="width:${Math.min((s.score / 100) * 100, 100)}%"></div></div>
              <div class="score-value">${Math.round((s.score / 100) * 20)}/20</div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="levels-section">
        <div class="level-row">
          <div class="level-label">Entry</div>
          <div class="level-value">$${s.entry.toFixed(8)}</div>
        </div>
        <div class="level-row">
          <div class="level-label">Stop Loss</div>
          <div class="level-value sl">$${s.stopLoss.toFixed(8)} <span class="level-distance">${s.stopDistancePercent.toFixed(2)}%</span></div>
        </div>
        <div class="level-row">
          <div class="level-label">Take Profit</div>
          <div class="level-value tp">$${s.takeProfit.toFixed(8)} <span class="level-distance">${s.rewardDistancePercent.toFixed(2)}%</span></div>
        </div>
        <div class="level-row">
          <div class="level-label">RR Ratio</div>
          <div class="level-value">1:${s.rrRatio.toFixed(1)}</div>
        </div>
      </div>
      
      <div class="sizing-section">
        <div class="sizing-row">
          <div class="sizing-label">Risk</div>
          <div class="sizing-value">$${s.riskAmount.toFixed(2)}</div>
        </div>
        <div class="sizing-row">
          <div class="sizing-label">Reward</div>
          <div class="sizing-value">$${s.rewardAmount.toFixed(2)}</div>
        </div>
        <div class="sizing-row">
          <div class="sizing-label">Position</div>
          <div class="sizing-value">${s.positionSize.toFixed(4)} coins</div>
        </div>
      </div>
      
      ${s.reasons && s.reasons.length > 0 ? `
      <div class="reasons-section">
        <div class="reason-list">
          ${s.reasons.map(r => `<div class="reason">${r}</div>`).join('')}
        </div>
      </div>
      ` : ''}
      
      ${s.warnings && s.warnings.length > 0 ? `
      <div class="warnings-section">
        ${s.warnings.map(w => `<div class="warning-chip">⚠ ${w}</div>`).join('')}
      </div>
      ` : ''}
      
      <div class="indicators-footer">
        <div class="indicator-item">
          <div class="indicator-label">RSI 1h</div>
          <div class="indicator-value">${s.indicators.rsi1h}</div>
        </div>
        <div class="indicator-item">
          <div class="indicator-label">RSI 4h</div>
          <div class="indicator-value">${s.indicators.rsi4h}</div>
        </div>
        <div class="indicator-item">
          <div class="indicator-label">Volume</div>
          <div class="indicator-value">${s.indicators.volSpike ? '📈 Spike' : 'Normal'}</div>
        </div>
        <div class="indicator-item">
          <div class="indicator-label">Funding</div>
          <div class="indicator-value" style="color:${s.indicators.fundingRate > 0 ? 'var(--red)' : 'var(--green)'}">${s.indicators.fundingRate?.toFixed(4)}%</div>
        </div>
      </div>
      
      <div class="card-actions">
        <button class="action-btn" onclick="analyzeAI('${s.symbol}')">Analyze AI</button>
        <button class="action-btn primary" onclick="openTrade('${s.symbol}')">Trade</button>
      </div>
    </div>
  `).join('');
}

function filterBy(type, value) {
  currentFilters[type] = value;
  // Update button states
  document.querySelectorAll(`.filter-btn`).forEach(btn => {
    btn.classList.remove('active');
    const btnValue = btn.textContent.trim();
    if (btnValue === value || (value === 'all' && btnValue === 'All')) {
      btn.classList.add('active');
    }
  });
  renderSignals();
}

function sortBy(value) {
  currentFilters.sort = value;
  renderSignals();
}

function analyzeAI(symbol) {
  window.location.href = `/scanner?sym=${symbol}`;
}

function openTrade(symbol) {
  window.location.href = `/terminal?sym=${symbol}`;
}

// Load on page load
(function() {
  fetch('/api/setups/signals').then(r => r.json()).then(d => {
    if (d.signals && d.signals.length > 0) {
      allSignals = d.signals;
      renderSignals();
    }
  });
})();
</script>
<script src="/js/session-check.js"></script>
</body>
</html>
